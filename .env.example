# ============================================================
# AROMA DONNA — переменные окружения Firebase
# 1) Скопируйте этот файл и назовите копию `.env`
# 2) Вставьте значения из Firebase Console → Project settings → Your apps → Web app
# 3) Перезапустите `npm run dev`
# Если переменные не заполнены, магазин работает в ДЕМО-РЕЖИМЕ (без Firebase).
# Файл .env НЕ добавляйте в Git и не отправляйте другим людям.
# ============================================================
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ============================================================
# Форма «Контакты» → e-mail через EmailJS (https://dashboard.emailjs.com)
# Эти три значения НЕ секретные: EmailJS рассчитан на вызов из браузера.
# Защиту настраивают в EmailJS: Account → Security (разрешённые домены, лимиты).
# ============================================================
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=

# ============================================================
# Форма «Контакты» → Telegram (только для сервера!)
# Без префикса VITE_ — поэтому Vite НЕ передаёт их в браузер.
# Локально: впишите в .env. На Vercel: Settings → Environment Variables.
# Токен никогда не коммитьте в GitHub.
# ============================================================
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ============================================================
# Оформление заказа: серверные функции /api/order и /api/order-notify (C3.3)
# Без префикса VITE_ — только сервер. На Vercel: Settings → Environment Variables.
# Пока они не заданы, сервер отвечает 503 и заказ оформить нельзя (сайт покажет понятное сообщение).
# Подробно: docs/LAUNCH_CHECKLIST.md
# ============================================================
# Ключ сервисного аккаунта Firebase (JSON целиком, закодированный в base64, одной строкой).
# Firebase Console → Project settings → Service accounts → Generate new private key.
# Это СЕКРЕТ: не коммитьте JSON-файл и не отправляйте его в чаты.
FIREBASE_SERVICE_ACCOUNT_B64=
# Случайная строка не короче 32 символов (например, `openssl rand -hex 32`). Секрет.
ORDER_HMAC_SECRET=

# ============================================================
# App Check (reCAPTCHA Enterprise / Google Cloud Fraud Defense) — проверка гостевых заказов
# Ключ reCAPTCHA Enterprise типа Web (по оценке, без checkbox) из Google Cloud → Security → Fraud Defense.
# Публичный (попадает в браузер). Тот же ключ регистрируется в Firebase Console → App Check.
# Ключи классического reCAPTCHA v3 (google.com/recaptcha/admin) НЕ подходят.
# Без этого ключа гость не сможет оформить заказ (вошедший покупатель — сможет).
# ============================================================
VITE_RECAPTCHA_SITE_KEY=
