rules_version = '2';

// Правила безопасности Firestore для AROMA DONNA.
// Каждый пользователь может читать и изменять ТОЛЬКО свой профиль и свои заказы.
// Администратор (документ admins/{uid}) может читать профили покупателей и все заказы
// и менять только статус заказа, а также управлять каталогом products (этап 5а).
// Проверка выполняется на стороне сервера Firebase, а не только в интерфейсе.
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Администратор — тот, у кого есть документ admins/{uid}.
    // Создать такой документ из браузера нельзя (см. правило admins ниже):
    // только вручную в Firebase Console или сервером через Firebase Admin SDK.
    // Даёт права: чтение всех заказов и смена их статуса (этап 3), чтение профилей users (этап 4),
    // чтение и запись товаров products (этап 5а).
    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Профиль пользователя: users/{uid}
    // Разрешены только поля name, email, createdAt — поэтому записать себе роль
    // (role, isAdmin и т.п.) невозможно.
    // Администратор может только ЧИТАТЬ профили (раздел «Покупатели», этап 4);
    // создавать, изменять и удалять их он не может.
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();

      allow create: if isOwner(userId)
                    && request.resource.data.keys().hasOnly(['name', 'email', 'createdAt'])
                    && request.resource.data.name is string
                    && request.resource.data.email is string
                    // Время ставит сервер Firebase (serverTimestamp), подделать дату нельзя
                    && request.resource.data.createdAt == request.time;

      allow update: if isOwner(userId)
                    && request.resource.data.keys().hasOnly(['name', 'email', 'createdAt'])
                    && request.resource.data.name is string
                    && request.resource.data.email is string
                    // Дату регистрации менять нельзя
                    && request.resource.data.createdAt == resource.data.createdAt;

      allow delete: if false;

      // Заказы пользователя: users/{uid}/orders/{orderId}
      // (чтение всех заказов администратором — правило collection group ниже)
      match /orders/{orderId} {
        allow read: if isOwner(userId);
        // Создавать можно только свой заказ с корректной суммой и статусом «Новый»
        allow create: if isOwner(userId)
                      && request.resource.data.id == orderId
                      && request.resource.data.userId == userId
                      && request.resource.data.total is number
                      && request.resource.data.total >= 0
                      && request.resource.data.items is list
                      && request.resource.data.items.size() > 0
                      && request.resource.data.status == 'new';
        // Изменять может только администратор и только статус; покупатель — ничего
        allow update: if isAdmin() && isValidOrderStatusChange();
        allow delete: if false;
      }
    }

    // Все заказы для админ-панели: запрос collectionGroup('orders').
    // Только чтение и только администратору. Запись по-прежнему проверяется правилом выше.
    match /{path=**}/orders/{orderId} {
      allow read: if isAdmin();
    }

    // Смена статуса: меняются только поля status и statusUpdatedAt,
    // статус — из списка (тот же список в src/utils/orderStatus.js),
    // время ставит сервер (serverTimestamp). Состав, сумму, адрес и т.п. изменить нельзя.
    function isValidOrderStatusChange() {
      return request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['status', 'statusUpdatedAt'])
          && request.resource.data.status in ['new', 'confirmed', 'shipped', 'delivered', 'cancelled']
          && request.resource.data.statusUpdatedAt == request.time;
    }

    // Администраторы: admins/{uid}
    // Пользователь может прочитать только СВОЙ документ — так интерфейс узнаёт, админ ли он.
    // Список админов и любые изменения из браузера запрещены
    // (Firebase Console и Admin SDK правила не проверяют).
    match /admins/{adminId} {
      allow get: if isOwner(adminId);
      allow list, create, update, delete: if false;
    }

    // Отзывы покупателей: reviews/{reviewId}
    // Читать может любой посетитель. Создавать — любой, но только в строгом формате.
    // Изменять и удалять из браузера нельзя (удаление спама — вручную в Firebase Console).
    match /reviews/{reviewId} {
      // (list нужен и для подсчёта средней оценки — getAggregateFromServer)
      allow read: if true;
      allow create: if isValidReview(request.resource.data);
      allow update, delete: if false;
    }

    function isValidReview(review) {
      return review.keys().hasOnly(['name', 'rating', 'text', 'lang', 'createdAt'])
          && review.keys().hasAll(['name', 'rating', 'text', 'createdAt'])
          && review.name is string
          && review.name.size() >= 2 && review.name.size() <= 50
          && review.rating is int
          && review.rating >= 1 && review.rating <= 5
          && review.text is string
          && review.text.size() >= 10 && review.text.size() <= 1000
          && (!('lang' in review) || review.lang in ['ru', 'ky', 'en'])
          // Время ставит сервер Firebase (serverTimestamp), подделать дату нельзя
          && review.createdAt == request.time;
    }

    // Товары каталога: products/{productId}
    // Посетитель читает только видимые товары (hidden == false). Запрос витрины обязан
    // содержать фильтр where('hidden', '==', false) — иначе Firestore его отклонит.
    // Администратор читает все товары (и скрытые), создаёт и изменяет их,
    // а удаляет только предварительно скрытые (hidden == true, этап 5c.8).
    // Формат проверяется здесь же; тот же формат — в src/utils/products.js.
    match /products/{productId} {
      // isAdmin() первым: для несуществующего документа resource == null
      allow read: if isAdmin() || resource.data.hidden == false;
      allow create, update: if isAdmin() && isValidProduct(request.resource.data, productId);
      // Видимый товар удалить нельзя — сначала его нужно скрыть.
      // Для несуществующего документа resource == null — удаление запрещено.
      allow delete: if isAdmin() && resource.data.hidden == true;
    }

    function isValidProduct(p, productId) {
      return p.keys().hasOnly(['id', 'name', 'brand', 'category', 'concentration', 'fragranceFamily',
                               'intensity', 'notes', 'rating', 'popularity', 'availability', 'isNew',
                               'isBestseller', 'description', 'volumes', 'price', 'image', 'hidden',
                               'updatedAt'])
          && p.keys().hasAll(['id', 'name', 'brand', 'category', 'concentration', 'fragranceFamily',
                              'intensity', 'notes', 'rating', 'popularity', 'availability', 'isNew',
                              'isBestseller', 'description', 'volumes', 'price', 'image', 'hidden',
                              'updatedAt'])
          // id в данных совпадает с id документа (он же адрес /product/{id})
          && p.id == productId
          && productId.matches('^[a-z0-9]+(-[a-z0-9]+)*$') && productId.size() <= 60
          && p.name is string && p.name.size() >= 1 && p.name.size() <= 100
          && p.brand is string && p.brand.size() >= 1 && p.brand.size() <= 100
          && p.category in ['women', 'men', 'unisex']
          && p.concentration in ['edt', 'edp', 'parfum']
          && p.fragranceFamily in ['floral', 'fruity', 'oriental', 'woody', 'citrus', 'gourmand', 'aquatic', 'aromatic']
          && p.intensity in ['light', 'moderate', 'intense']
          && p.availability in ['inStock', 'lowStock', 'outOfStock']
          && p.isNew is bool && p.isBestseller is bool && p.hidden is bool
          && p.rating is number && p.rating >= 0 && p.rating <= 5
          && p.popularity is number && p.popularity >= 0 && p.popularity <= 100
          && p.image is string && p.image.size() <= 500
          && p.price is number && p.price > 0 && p.price <= 10000000
          && isValidProductText(p.description)
          && isValidProductNotes(p.notes)
          && isValidVolumes(p.volumes)
          // Время ставит сервер Firebase (serverTimestamp), подделать дату нельзя
          && p.updatedAt == request.time;
    }

    function isValidProductText(d) {
      return d is map
          && d.keys().hasOnly(['ru', 'ky', 'en']) && d.keys().hasAll(['ru', 'ky', 'en'])
          && d.ru is string && d.ru.size() >= 1 && d.ru.size() <= 2000
          && d.ky is string && d.ky.size() >= 1 && d.ky.size() <= 2000
          && d.en is string && d.en.size() >= 1 && d.en.size() <= 2000;
    }

    function isValidProductNotes(n) {
      return n is map
          && n.keys().hasOnly(['top', 'heart', 'base']) && n.keys().hasAll(['top', 'heart', 'base'])
          && n.top is list && n.top.size() <= 10
          && n.heart is list && n.heart.size() <= 10
          && n.base is list && n.base.size() <= 10;
    }

    // Объёмы: от 1 до 4 вариантов { ml, price }. Циклов в правилах нет — проверяем по индексам
    function isValidVolumes(v) {
      return v is list && v.size() >= 1 && v.size() <= 4
          && isValidVolume(v[0])
          && (v.size() < 2 || isValidVolume(v[1]))
          && (v.size() < 3 || isValidVolume(v[2]))
          && (v.size() < 4 || isValidVolume(v[3]));
    }

    function isValidVolume(item) {
      return item is map
          && item.keys().hasOnly(['ml', 'price']) && item.keys().hasAll(['ml', 'price'])
          && item.ml is int && item.ml > 0 && item.ml <= 1000
          && item.price is number && item.price > 0 && item.price <= 10000000;
    }

    // Всё остальное закрыто
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
