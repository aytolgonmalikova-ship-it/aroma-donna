rules_version = '2';

// Правила безопасности Firestore для AROMA DONNA.
// Каждый пользователь может читать и изменять ТОЛЬКО свой профиль и читать свои заказы
// (заказы создаёт только сервер /api/order через Admin SDK).
// Администратор (документ admins/{uid}) может читать профили покупателей и все заказы
// и менять только статус заказа, управлять каталогом products (этап 5а) и модерировать отзывы.
// Главный администратор (adminConfig/primary.ownerUid) дополнительно управляет администраторами (этап A3).
// Проверка выполняется на стороне сервера Firebase, а не только в интерфейсе.
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Администратор — тот, у кого есть документ admins/{uid}.
    // Из браузера такой документ может создать только главный администратор (правило admins ниже);
    // первого администратора и adminConfig/primary создают вручную в Firebase Console.
    // Даёт права в разделах админ-панели: чтение всех заказов и смена их статуса (этап 3),
    // чтение профилей users (этап 4), чтение и запись товаров products, удаление только скрытых (этап 5),
    // чтение всех отзывов, смена их статуса и удаление отклонённых (этап D).
    // Управлять администраторами isAdmin() не даёт — для этого нужен isPrimaryOwner() (этап A3).
    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Профиль пользователя: users/{uid}
    // Разрешены только поля name, email, createdAt — поэтому записать себе роль
    // (role, isAdmin и т.п.) невозможно.
    // Администратор может только ЧИТАТЬ профили (раздел «Покупатели», этап 4);
    // создавать, изменять и удалять их он не может.
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();

      allow create: if isOwner(userId)
                    && request.resource.data.keys().hasOnly(['name', 'email', 'createdAt'])
                    && request.resource.data.name is string
                    && request.resource.data.email is string
                    // Время ставит сервер Firebase (serverTimestamp), подделать дату нельзя
                    && request.resource.data.createdAt == request.time;

      allow update: if isOwner(userId)
                    && request.resource.data.keys().hasOnly(['name', 'email', 'createdAt'])
                    && request.resource.data.name is string
                    && request.resource.data.email is string
                    // Дату регистрации менять нельзя
                    && request.resource.data.createdAt == resource.data.createdAt;

      allow delete: if false;

      // Заказы пользователя: users/{uid}/orders/{orderId}
      // (чтение всех заказов администратором — правило collection group ниже)
      // Создаёт заказы ТОЛЬКО сервер (/api/order, Firebase Admin SDK — правила его не ограничивают):
      // цены, итог, статусы и номер считает сервер. Из браузера создать заказ нельзя (C3.3, этап 6).
      match /orders/{orderId} {
        allow read: if isOwner(userId);
        allow create: if false;
        // Изменять может только администратор и только статус; покупатель — ничего
        allow update: if isAdmin() && isValidOrderStatusChange();
        allow delete: if false;
      }
    }

    // Гостевые заказы: guests/{guestKey}/orders/{orderId} (C3.3).
    // guestKey — HMAC гостевой сессии, а не UID: гость не входит в аккаунт и не читает заказ через Firestore.
    // Создаёт и обновляет уведомление только сервер (Admin SDK). Читает только администратор —
    // правило collection group ниже. Администратор (владелец или обычный) меняет только статус —
    // та же проверка изменённых полей, что у заказов покупателей. Сам документ guests/{guestKey}
    // и прочие подколлекции закрыты общим запретом в конце файла.
    match /guests/{guestKey}/orders/{orderId} {
      allow create, delete: if false;
      allow update: if isAdmin() && isValidOrderStatusChange();
    }

    // Все заказы для админ-панели (покупателей и гостей): запрос collectionGroup('orders').
    // Только чтение и только администратору. Запись проверяется правилами выше.
    match /{path=**}/orders/{orderId} {
      allow read: if isAdmin();
    }

    // Смена статуса: меняются только поля status и statusUpdatedAt,
    // статус — из списка (тот же список в src/utils/orderStatus.js),
    // время ставит сервер (serverTimestamp). Состав, сумму, цены, адрес, оплату, userId, номер,
    // дату, customerType и уведомление (notification) изменить нельзя.
    function isValidOrderStatusChange() {
      return request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['status', 'statusUpdatedAt'])
          && request.resource.data.status in ['new', 'confirmed', 'shipped', 'delivered', 'cancelled']
          && request.resource.data.statusUpdatedAt == request.time;
    }

    // ---------- Администраторы: роли owner и admin (этап A3) ----------
    // admin — любой, у кого есть документ admins/{uid} (isAdmin(), права в разделах не меняются).
    // owner — главный администратор: его UID хранится в ОДНОМ документе adminConfig/primary (ownerUid),
    // поэтому владелец всегда ровно один. Поле role в admins/{uid} правами не является и не проверяется.
    // Управлять администраторами может только владелец. adminConfig/primary создаётся вручную
    // в Firebase Console; пока его нет, управлять ролями не может никто (остальные разделы работают).
    // Firebase Console и Admin SDK правила не проверяют.

    function adminConfig() {
      return get(/databases/$(database)/documents/adminConfig/primary).data;
    }

    // adminConfig/primary ПОСЛЕ текущей записи — с учётом всех записей того же пакета (writeBatch)
    // или транзакции. Для одиночной записи в другой документ совпадает с adminConfig().
    function adminConfigAfter() {
      return getAfter(/databases/$(database)/documents/adminConfig/primary).data;
    }

    // Главный администратор: администратор, чей UID записан в adminConfig/primary.ownerUid
    function isPrimaryOwner() {
      return isAdmin() && adminConfig().ownerUid == request.auth.uid;
    }

    // Firebase Auth UID: 1–128 символов, только латиница, цифры, «_» и «-»
    function isUid(value) {
      return value is string && value.matches('^[A-Za-z0-9_-]{1,128}$');
    }

    // Администраторы: admins/{uid}
    match /admins/{adminId} {
      // Свой документ — любому вошедшему (так интерфейс узнаёт, админ ли он); чужие и список — только владельцу
      allow get: if isOwner(adminId) || isPrimaryOwner();
      allow list: if isPrimaryOwner();
      // Новый администратор: только владелец, не себе, только зарегистрированный на сайте UID
      // (профиль users/{uid} создаёт лишь сам владелец этого UID). Перезаписать существующий
      // документ нельзя: для существующего документа это update, а он запрещён.
      allow create: if isPrimaryOwner()
                    && adminId != request.auth.uid
                    && isUid(adminId)
                    && exists(/databases/$(database)/documents/users/$(adminId))
                    && isValidNewAdmin(request.resource.data);
      allow update: if false;
      // Отозвать доступ: только владелец и только у обычного администратора —
      // не у себя, не у владельца и не у того, кому предложена роль владельца.
      // Владелец и кандидат проверяются и до записи, и после всего пакета (getAfter): одним
      // writeBatch нельзя предложить роль администратору и тут же отозвать его доступ.
      allow delete: if isPrimaryOwner()
                    && adminId != request.auth.uid
                    && adminId != adminConfig().ownerUid
                    && adminId != adminConfig().pendingOwnerUid
                    && adminId != adminConfigAfter().ownerUid
                    && adminId != adminConfigAfter().pendingOwnerUid;
    }

    function isValidNewAdmin(a) {
      return a.keys().hasOnly(['grantedAt', 'grantedBy', 'label'])
          && a.keys().hasAll(['grantedAt', 'grantedBy'])
          && a.grantedAt == request.time
          && a.grantedBy == request.auth.uid
          && (!('label' in a)
              || (a.label is string && a.label.size() >= 1 && a.label.size() <= 100
                  && !a.label.matches('^\\s*$')));
    }

    // Главный администратор: adminConfig/primary — единственный документ.
    // Создать и удалить его из браузера нельзя. Изменение — только одним из четырёх действий
    // передачи роли; ownerUid меняется ТОЛЬКО при принятии действующего предложения
    // самим назначенным администратором (и только пока он администратор).
    match /adminConfig/{docId} {
      allow get: if docId == 'primary'
                 && isAdmin()
                 && (resource.data.ownerUid == request.auth.uid
                     || resource.data.pendingOwnerUid == request.auth.uid);
      allow list, create, delete: if false;
      allow update: if docId == 'primary'
                    && isAdmin()
                    && isValidAdminConfig(request.resource.data)
                    && request.resource.data.updatedAt == request.time
                    && request.resource.data.updatedBy == request.auth.uid
                    && (isOfferOwnerTransfer()
                        || isCancelOwnerTransfer()
                        || isDeclineOwnerTransfer()
                        || isAcceptOwnerTransfer());
    }

    // Точный набор полей; UID — строки нужного формата, pendingOwnerUid и previousOwnerUid — UID или null
    function isValidAdminConfig(c) {
      return c.keys().hasOnly(['ownerUid', 'pendingOwnerUid', 'previousOwnerUid', 'updatedAt', 'updatedBy'])
          && c.keys().hasAll(['ownerUid', 'pendingOwnerUid', 'previousOwnerUid', 'updatedAt', 'updatedBy'])
          && isUid(c.ownerUid)
          && (c.pendingOwnerUid == null || isUid(c.pendingOwnerUid))
          && (c.previousOwnerUid == null || isUid(c.previousOwnerUid));
    }

    // Предложить роль (или заменить предложение): только владелец, только администратору, не себе.
    // existsAfter: кандидат должен остаться администратором и после всего пакета (writeBatch) —
    // нельзя одним пакетом предложить роль и удалить его документ admins.
    function isOfferOwnerTransfer() {
      let before = resource.data;
      let after = request.resource.data;
      return before.ownerUid == request.auth.uid
          && after.ownerUid == before.ownerUid
          && after.previousOwnerUid == before.previousOwnerUid
          && after.pendingOwnerUid != null
          && after.pendingOwnerUid != request.auth.uid
          && existsAfter(/databases/$(database)/documents/admins/$(after.pendingOwnerUid));
    }

    // Отменить предложение: только владелец
    function isCancelOwnerTransfer() {
      let before = resource.data;
      let after = request.resource.data;
      return before.ownerUid == request.auth.uid
          && before.pendingOwnerUid != null
          && after.pendingOwnerUid == null
          && after.ownerUid == before.ownerUid
          && after.previousOwnerUid == before.previousOwnerUid;
    }

    // Отклонить предложение: только тот, кому оно сделано
    function isDeclineOwnerTransfer() {
      let before = resource.data;
      let after = request.resource.data;
      return before.pendingOwnerUid == request.auth.uid
          && after.pendingOwnerUid == null
          && after.ownerUid == before.ownerUid
          && after.previousOwnerUid == before.previousOwnerUid;
    }

    // Принять роль: только тот, кому предложено, и только пока он администратор (isAdmin() в allow update).
    // Одна запись: новый владелец получает роль, прежний становится обычным администратором.
    function isAcceptOwnerTransfer() {
      let before = resource.data;
      let after = request.resource.data;
      return before.pendingOwnerUid == request.auth.uid
          && after.ownerUid == request.auth.uid
          && after.previousOwnerUid == before.ownerUid
          && after.pendingOwnerUid == null;
    }

    // Отзывы покупателей: reviews/{reviewId} — модерация (этап D).
    // Посетитель (в том числе без входа) читает только одобренные отзывы (status == 'approved').
    // Публичные запросы обязаны содержать фильтр where('status', '==', 'approved') — иначе
    // Firestore отклонит запрос целиком (правила не фильтруют выдачу).
    // Создать отзыв может любой посетитель, без входа: строгий формат и только status == 'pending'.
    // Администратор (isAdmin()) читает отзывы всех статусов, меняет только status и moderatedAt
    // и навсегда удаляет только отклонённые (status == 'rejected'). Посетитель ничего не меняет и не удаляет.
    match /reviews/{reviewId} {
      // isAdmin() первым: для несуществующего документа resource == null.
      // (list нужен и для подсчёта средней оценки — getAggregateFromServer)
      allow read: if isAdmin() || resource.data.status == 'approved';
      allow create: if isValidReview(request.resource.data);
      allow update: if isAdmin() && isValidReviewModeration();
      allow delete: if isAdmin() && resource.data.status == 'rejected';
    }

    function isValidReview(review) {
      return review.keys().hasOnly(['name', 'rating', 'text', 'lang', 'status', 'createdAt'])
          && review.keys().hasAll(['name', 'rating', 'text', 'status', 'createdAt'])
          && review.name is string
          && review.name.size() >= 2 && review.name.size() <= 50
          && review.rating is int
          && review.rating >= 1 && review.rating <= 5
          && review.text is string
          && review.text.size() >= 10 && review.text.size() <= 1000
          && (!('lang' in review) || review.lang in ['ru', 'ky', 'en'])
          // Новый отзыв — только на модерацию: опубликовать или отклонить может лишь администратор
          && review.status == 'pending'
          // Время ставит сервер Firebase (serverTimestamp), подделать дату нельзя
          && review.createdAt == request.time;
    }

    // Модерация: меняются только поля status и moderatedAt, статус — из списка
    // (тот же список в src/services/reviewsStore.js), время ставит сервер (serverTimestamp).
    // Имя, оценку, текст, язык и дату создания изменить нельзя.
    function isValidReviewModeration() {
      return request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['status', 'moderatedAt'])
          && request.resource.data.status in ['pending', 'approved', 'rejected']
          && request.resource.data.moderatedAt == request.time;
    }

    // Товары каталога: products/{productId}
    // Посетитель читает только видимые товары (hidden == false). Запрос витрины обязан
    // содержать фильтр where('hidden', '==', false) — иначе Firestore его отклонит.
    // Администратор читает все товары (и скрытые), создаёт и изменяет их,
    // а удаляет только предварительно скрытые (hidden == true, этап 5c.8).
    // Формат проверяется здесь же; тот же формат — в src/utils/products.js.
    match /products/{productId} {
      // isAdmin() первым: для несуществующего документа resource == null
      allow read: if isAdmin() || resource.data.hidden == false;
      allow create, update: if isAdmin() && isValidProduct(request.resource.data, productId);
      // Видимый товар удалить нельзя — сначала его нужно скрыть.
      // Для несуществующего документа resource == null — удаление запрещено.
      allow delete: if isAdmin() && resource.data.hidden == true;
    }

    function isValidProduct(p, productId) {
      return p.keys().hasOnly(['id', 'name', 'brand', 'category', 'concentration', 'fragranceFamily',
                               'intensity', 'notes', 'rating', 'popularity', 'availability', 'isNew',
                               'isBestseller', 'description', 'volumes', 'price', 'image', 'hidden',
                               'updatedAt'])
          && p.keys().hasAll(['id', 'name', 'brand', 'category', 'concentration', 'fragranceFamily',
                              'intensity', 'notes', 'rating', 'popularity', 'availability', 'isNew',
                              'isBestseller', 'description', 'volumes', 'price', 'image', 'hidden',
                              'updatedAt'])
          // id в данных совпадает с id документа (он же адрес /product/{id})
          && p.id == productId
          && productId.matches('^[a-z0-9]+(-[a-z0-9]+)*$') && productId.size() <= 60
          && p.name is string && p.name.size() >= 1 && p.name.size() <= 100
          && p.brand is string && p.brand.size() >= 1 && p.brand.size() <= 100
          && p.category in ['women', 'men', 'unisex']
          && p.concentration in ['edt', 'edp', 'parfum']
          && p.fragranceFamily in ['floral', 'fruity', 'oriental', 'woody', 'citrus', 'gourmand', 'aquatic', 'aromatic']
          && p.intensity in ['light', 'moderate', 'intense']
          && p.availability in ['inStock', 'lowStock', 'outOfStock']
          && p.isNew is bool && p.isBestseller is bool && p.hidden is bool
          && p.rating is number && p.rating >= 0 && p.rating <= 5
          && p.popularity is number && p.popularity >= 0 && p.popularity <= 100
          && p.image is string && p.image.size() <= 500
          && p.price is number && p.price > 0 && p.price <= 10000000
          && isValidProductText(p.description)
          && isValidProductNotes(p.notes)
          && isValidVolumes(p.volumes)
          // Время ставит сервер Firebase (serverTimestamp), подделать дату нельзя
          && p.updatedAt == request.time;
    }

    function isValidProductText(d) {
      return d is map
          && d.keys().hasOnly(['ru', 'ky', 'en']) && d.keys().hasAll(['ru', 'ky', 'en'])
          && d.ru is string && d.ru.size() >= 1 && d.ru.size() <= 2000
          && d.ky is string && d.ky.size() >= 1 && d.ky.size() <= 2000
          && d.en is string && d.en.size() >= 1 && d.en.size() <= 2000;
    }

    function isValidProductNotes(n) {
      return n is map
          && n.keys().hasOnly(['top', 'heart', 'base']) && n.keys().hasAll(['top', 'heart', 'base'])
          && n.top is list && n.top.size() <= 10
          && n.heart is list && n.heart.size() <= 10
          && n.base is list && n.base.size() <= 10;
    }

    // Объёмы: от 1 до 4 вариантов { ml, price }. Циклов в правилах нет — проверяем по индексам
    function isValidVolumes(v) {
      return v is list && v.size() >= 1 && v.size() <= 4
          && isValidVolume(v[0])
          && (v.size() < 2 || isValidVolume(v[1]))
          && (v.size() < 3 || isValidVolume(v[2]))
          && (v.size() < 4 || isValidVolume(v[3]));
    }

    function isValidVolume(item) {
      return item is map
          && item.keys().hasOnly(['ml', 'price']) && item.keys().hasAll(['ml', 'price'])
          && item.ml is int && item.ml > 0 && item.ml <= 1000
          && item.price is number && item.price > 0 && item.price <= 10000000;
    }

    // Всё остальное закрыто
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
