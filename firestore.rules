rules_version = '2';

// Правила безопасности Firestore для AROMA DONNA.
// Каждый пользователь может читать и изменять ТОЛЬКО свой профиль и свои заказы.
// Проверка выполняется на стороне сервера Firebase, а не только в интерфейсе.
service cloud.firestore {
  match /databases/{database}/documents {

    // Профиль пользователя: users/{uid}
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // Заказы пользователя: users/{uid}/orders/{orderId}
      match /orders/{orderId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        // Создавать можно только свой заказ с корректной суммой; изменять и удалять нельзя
        allow create: if request.auth != null
                      && request.auth.uid == userId
                      && request.resource.data.total is number
                      && request.resource.data.total >= 0
                      && request.resource.data.items is list
                      && request.resource.data.items.size() > 0;
        allow update, delete: if false;
      }
    }

    // Отзывы покупателей: reviews/{reviewId}
    // Читать может любой посетитель. Создавать — любой, но только в строгом формате.
    // Изменять и удалять из браузера нельзя (удаление спама — вручную в Firebase Console).
    match /reviews/{reviewId} {
      // (list нужен и для подсчёта средней оценки — getAggregateFromServer)
      allow read: if true;
      allow create: if isValidReview(request.resource.data);
      allow update, delete: if false;
    }

    function isValidReview(review) {
      return review.keys().hasOnly(['name', 'rating', 'text', 'lang', 'createdAt'])
          && review.keys().hasAll(['name', 'rating', 'text', 'createdAt'])
          && review.name is string
          && review.name.size() >= 2 && review.name.size() <= 50
          && review.rating is int
          && review.rating >= 1 && review.rating <= 5
          && review.text is string
          && review.text.size() >= 10 && review.text.size() <= 1000
          && (!('lang' in review) || review.lang in ['ru', 'ky', 'en'])
          // Время ставит сервер Firebase (serverTimestamp), подделать дату нельзя
          && review.createdAt == request.time;
    }

    // Всё остальное закрыто
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
